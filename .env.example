# DB
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Optional: exact Neon hostname used to block accidental Main/Dev cross-wiring.
DATABASE_EXPECTED_HOST=""

# COOKIE
COOKIE_PASSWORD="replace_with_at_least_32_random_characters"
BOOKMARKLET_SECRET="replace_with_a_separate_random_signing_secret"
APP_URL="http://localhost:3000"
MAINTENANCE_MODE="false"
# Optional public operational times (ISO 8601 with timezone). Leave unknown values empty.
MAINTENANCE_EXPECTED_END_AT=""
MAINTENANCE_UPDATED_AT=""
# Optional deliberate HTTP retry interval, 1–86400 seconds; no guessed default.
MAINTENANCE_RETRY_AFTER_SECONDS=""
GOOGLE_SITE_VERIFICATION="google_search_console_verification_token"

# Kakao Maps JavaScript SDK
NEXT_PUBLIC_KAKAO_MAP_APP_KEY="kakao_javascript_key"

# DISCORD OAUTH
DISCORD_CLIENT_ID="discord_client_id"
DISCORD_CLIENT_SECRET="discord_client_secret"
DISCORD_REDIRECT_URI="http://localhost:3000/discord/complete"

# Vercel Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_read_write_token"
BLOB_STORE_ID="vercel_blob_store_id"
BLOB_WEBHOOK_PUBLIC_KEY="vercel_blob_webhook_public_key"
PRIVATE_BLOB_READ_WRITE_TOKEN="vercel_private_blob_read_write_token"

# Vercel Cron
CRON_SECRET="replace_with_a_separate_random_cron_secret"
## Temporary: only true enables theme switching; false/unset forces Dark.
## NEXT_PUBLIC values require restarting dev or rebuilding the deployment.
NEXT_PUBLIC_ENABLE_THEME_SWITCHING=false

# X API (home page "NOSTALGIA 공식 소식")
## Pay-per-use app-only Bearer Token from https://console.x.com (app > keys).
## Reads the latest public post of @NOSTALGIA_573 (text, photo, author) every 6 hours;
## unset shows the load-error state.
X_BEARER_TOKEN=""
# 홈 공식 소식(일본어 트윗) 자동 번역. 비우면 원문만 표시
GEMINI_API_KEY=""
