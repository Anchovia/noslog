generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                         @id @default(autoincrement())
  username                 String?                     @unique
  nostalgiaName            String?                     @map("nostalgia_name")
  discordId                String?                     @unique @map("discord_id")
  discordName              String?                     @map("discord_name")
  discordUsername          String?                     @map("discord_username")
  avatar                   String?
  avatarUserManaged        Boolean                     @default(false) @map("avatar_user_managed")
  country                  String                      @default("ko-KR")
  locale                   LocaleCode                  @default(ko)
  showLocalizedMusicTitle  Boolean                     @default(true) @map("show_localized_music_title")
  profileCompletedAt       DateTime?                   @map("profile_completed_at")
  preferredArcadeId        Int?                        @map("preferred_arcade_id")
  hideNostalgiaName        Boolean                     @default(true) @map("hide_nostalgia_name")
  hideDiscordName          Boolean                     @default(true) @map("hide_discord_name")
  hidePlayCount            Boolean                     @default(true) @map("hide_play_count")
  hidePreferredArcade      Boolean                     @default(true) @map("hide_preferred_arcade")
  hidePlayActivity         Boolean                     @default(true) @map("hide_play_activity")
  // 플레이 점수 공개(2026-09-18) — 켜면 랭킹에서 빠지고 프로필의 점수 · 기록이 남에게 가려진다. 기본 공개
  hidePlayScores           Boolean                     @default(false) @map("hide_play_scores")
  preferredArcade          Arcade?                     @relation(fields: [preferredArcadeId], references: [id], onDelete: SetNull)
  role                     UserRole                    @default(user)
  syncTokenVersion         Int                         @default(0) @map("sync_token_version")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  playData                 PlayData[]
  bestGrades               UserBestGrade[]
  ratingHistory            UserRatingHistory[]
  bingoProgress            BingoCellProgress[]
  communityEvaluations     CommunityChartEvaluation[]
  communityHelpful         CommunityOpinionHelpful[]
  communityReplies         CommunityOpinionReply[]
  communityReplyLikes      CommunityOpinionReplyLike[]
  communityReports         CommunityOpinionReport[]    @relation("CommunityReportReporter")
  communityReportsAuthored CommunityOpinionReport[]    @relation("CommunityReportAuthor")
  chartGoalVotes           ChartGoalVote[]
  chartGoalVoteAudit       ChartGoalVoteAudit[]
  dataSyncs                DataSync[]
  chartPlayHistory         ChartPlayHistory[]
  chartRecordSnapshots     ChartRecordSnapshot[]
  examSubmissions          ExamSubmission[]            @relation("ExamSubmissionAuthor")
  examSubmissionsReviewed  ExamSubmission[]            @relation("ExamSubmissionReviewer")
  examAchievements         ExamAchievement[]
  uploadTokenGrants        UploadTokenGrant[]
  feedbackReports          FeedbackReport[]
  cabinetChecks            ArcadeCabinetCheck[]
  chartPatternsCreated     ChartPattern[]              @relation("ChartPatternCreatedBy")
  chartPatternsUpdated     ChartPattern[]              @relation("ChartPatternUpdatedBy")
  chartPatternsPublished   ChartPattern[]              @relation("ChartPatternPublishedBy")
  chartPatternRevisions    ChartPatternRevision[]      @relation("ChartPatternRevisionCreatedBy")
  communityEvents          CommunityEvent[]            @relation("CommunityEventAuthor")
  communityEventsReviewed  CommunityEvent[]            @relation("CommunityEventReviewer")
  pollVotes                PollVote[]
  fieldProposals           ChartFieldProposal[]        @relation("ChartFieldProposalAuthor")
  fieldProposalsReviewed   ChartFieldProposal[]        @relation("ChartFieldProposalReviewer")
  contributionPoints       ContributionPoint[]
  chartDrafts              ChartDraft[]                @relation("ChartDraftAuthor")
  chartDraftsReviewed      ChartDraft[]                @relation("ChartDraftReviewer")
  chartComments            ChartComment[]              @relation("ChartCommentAuthor")
  chartCommentsResolved    ChartComment[]              @relation("ChartCommentResolver")
  chartPatternsAuthored    ChartPattern[]              @relation("ChartPatternAuthor")
  achievements             UserAchievement[]
  achievementShowcase      UserAchievementShowcase[]
  pinnedRecords            UserPinnedRecord[]
  ratings                  PlayerRating[]
  stats                    PlayerStats?

  @@index([preferredArcadeId])
  // 관리자 대시보드 가입자 집계(2026-10-16 DB 재설계 P2)
  @@index([createdAt])
}

// 사용자가 제출한 오류 제보와 처리 상태를 관리함
model FeedbackReport {
  id               Int               @id @default(autoincrement())
  // 제보 종류 「bug」 · 「idea」 — 오락실 제보 · 2026-09-18 이전 제보는 비어 있음
  category         FeedbackCategory?
  content          String
  imageUrl         String?           @map("image_url")
  status           FeedbackStatus    @default(open)
  userId           Int               @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  reviewedAt       DateTime?         @map("resolved_at")
  // 관리자 답변(2026-09-18) — 처리 완료 때 쓰면 제보한 사람의 「내 제보」 에 보인다. authorSeenAt = 제보한 사람이 읽은 때(새 답변 점)
  reply            String?
  repliedAt        DateTime?         @map("replied_at")
  authorSeenAt     DateTime?         @map("reply_seen_at")
  arcadeId         Int?
  arcade           Arcade?           @relation(fields: [arcadeId], references: [id], onDelete: SetNull)
  cabinetId        Int?
  cabinet          ArcadeCabinet?    @relation(fields: [cabinetId], references: [id], onDelete: SetNull)
  arcadeReportType ArcadeReportType?
  submissionId     String?

  @@unique([userId, submissionId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  // 외래 키 — 오락실 공개 화면이 기체별 열린 제보를 센다(2026-10-16 P2)
  @@index([arcadeId])
  @@index([cabinetId])
}

// 관리자가 작성하고 홈에 공개하는 서비스 공지사항
model Announcement {
  id           Int                       @id @default(autoincrement())
  isPublished  Boolean                   @default(false) @map("is_published")
  publishedAt  DateTime?                 @map("published_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  publicSlug   String?                   @unique @map("public_slug")
  placement    AnnouncementPlacement     @default(ROUTINE)
  category     AnnouncementCategory      @default(NOTICE)
  priority     Int                       @default(0)
  activeFrom   DateTime?                 @map("active_from")
  expiresAt    DateTime?                 @map("expires_at")
  translations AnnouncementTranslation[]
  poll         Poll?

  @@index([isPublished, publishedAt])
}

enum AnnouncementPlacement {
  ROUTINE
  SERVICE_CRITICAL
}

// 일상 공지의 분류 태그. 중대 공지 여부는 placement 가 따로 가짐
enum AnnouncementCategory {
  UPDATE
  MAINTENANCE
  DATA
  NOTICE
}

model AnnouncementTranslation {
  id             Int          @id @default(autoincrement())
  announcementId Int          @map("announcement_id")
  locale         LocaleCode
  title          String
  content        String
  modifiedAt     DateTime?    @map("modified_at")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, locale])
}

// 유저가 쓰고 관리자가 승인해 공개하는 이벤트 글 (2026-09-18).
// 작성 중인 판(title · content · 기간 · 배너)과 승인된 공개판(published*)을 따로 둔다 —
// 공개된 글을 고치는 동안에도 승인 전까지 이전 공개판이 보인다. 기간은 한국 날짜, endsAt 은 끝 날 다음 날 0시(미포함)
model CommunityEvent {
  id                 Int                  @id @default(autoincrement())
  authorId           Int                  @map("author_id")
  author             User                 @relation("CommunityEventAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  status             CommunityEventStatus @default(draft)
  title              String
  content            String
  startsAt           DateTime             @map("starts_at")
  endsAt             DateTime             @map("ends_at")
  bannerUrl          String?              @map("banner_url")
  publishedTitle     String?              @map("published_title")
  publishedContent   String?              @map("published_content")
  publishedStartsAt  DateTime?            @map("published_starts_at")
  publishedEndsAt    DateTime?            @map("published_ends_at")
  publishedBannerUrl String?              @map("published_banner_url")
  publishedAt        DateTime?            @map("published_at")
  submittedAt        DateTime?            @map("submitted_at")
  reviewNote         String?              @map("review_note")
  reviewedAt         DateTime?            @map("reviewed_at")
  reviewedById       Int?                 @map("reviewer_id")
  reviewedBy         User?                @relation("CommunityEventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  poll               Poll?

  @@index([status, submittedAt])
  @@index([authorId, updatedAt])
  @@index([publishedStartsAt])
  @@index([reviewedById])
}

// 이벤트 글 상태 — 작성 중인 판의 상태. 공개 여부는 공개판(publishedAt)이 따로 말한다
enum CommunityEventStatus {
  draft
  pending
  changes_requested
  approved
  rejected
}

// 글에 딸린 투표 (2026-09-23 V2) — 본문에 흔적을 남기지 않고 글 하나에 하나씩 딸린다.
// 질문 · 선택지 글은 번역 표에 두고(공지는 ko · ja · en 세 벌, 이벤트는 쓴 언어 한 벌), 표는 PollVote 가 센다.
// 표가 하나라도 들어오면 질문 · 선택지를 잠그고(추가만 허용) 마감 시각만 바꿀 수 있다 — 규칙은 서버에서 지킨다
model Poll {
  id              Int                   @id @default(autoincrement())
  announcementId  Int?                  @unique @map("announcement_id")
  announcement    Announcement?         @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  eventId         Int?                  @unique @map("event_id")
  event           CommunityEvent?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// 여러 개 고르기 — 끄면 누르는 즉시 한 표, 켜면 「투표하기」 버튼으로 모아서 낸다
  multiple        Boolean               @default(false)
  /// 여러 개 고르기일 때 최대 개수. 비우면 선택지 수만큼
  maxChoices      Int?                  @map("max_choices")
  closesAt        DateTime?             @map("closes_at")
  results         PollResultsVisibility @default(ALWAYS)
  /// 누가 무엇을 골랐는지 보여 줄지. 기본은 숨김(익명)
  showVoters      Boolean               @default(false) @map("show_voters")
  /// 게시한 뒤에도 선택지를 더할 수 있게 할지
  allowAddOptions Boolean               @default(false) @map("allow_add_options")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  translations    PollTranslation[]
  options         PollOption[]
  votes           PollVote[]

  @@index([closesAt])
}

// 결과를 언제 보여 줄지 — 항상 · 투표한 뒤 · 마감한 뒤
enum PollResultsVisibility {
  ALWAYS
  AFTER_VOTE
  AFTER_CLOSE
}

model PollTranslation {
  id       Int        @id @default(autoincrement())
  pollId   Int        @map("poll_id")
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  locale   LocaleCode
  question String

  @@unique([pollId, locale])
}

model PollOption {
  id           Int                     @id @default(autoincrement())
  pollId       Int                     @map("poll_id")
  poll         Poll                    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  /// 보이는 차례 — 글쓴이가 넣은 순서 그대로 둔다(득표순으로 바꾸지 않는다)
  position     Int
  createdAt    DateTime                @default(now()) @map("created_at")
  translations PollOptionTranslation[]
  votes        PollVote[]

  @@unique([pollId, position])
}

model PollOptionTranslation {
  id       Int        @id @default(autoincrement())
  optionId Int        @map("option_id")
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  locale   LocaleCode
  text     String

  @@unique([optionId, locale])
}

// 한 사람이 한 선택지에 한 표 — 여러 개 고르기면 줄이 여러 개 생긴다
model PollVote {
  // 외래 키가 복합 기본 키(@@id)의 앞 칸이라 이미 인덱스가 있다 — prisma-lint 가 @@id 를 인덱스로 보지 않는다
  /// prisma-lint-ignore-model require-field-index
  pollId    Int        @map("poll_id")
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  Int        @map("option_id")
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@id([optionId, userId])
  @@index([pollId, userId])
  @@index([userId])
}

// 유저가 선택할 수 있는 오락실 목록을 관리자 데이터로 관리함
model Arcade {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  latitude      Float?
  longitude     Float?
  playPrice     Int?     @map("play_price")
  coinCount     Int?     @map("coin_count")
  businessHours Json?    @map("business_hours")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  users         User[]

  publicDetails ArcadePublicDetails?
  cabinets      ArcadeCabinet[]
  publicPhotos  ArcadePublicPhoto[]
  identities    ArcadeLocalizedIdentity[]
  slugAliases   ArcadeSlugAlias[]
  reports       FeedbackReport[]

  @@index([isActive, name])
}

// Optional verified public facts; legacy editor fields remain intact.
model ArcadePublicDetails {
  arcadeId           Int       @id
  arcade             Arcade    @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  slug               String    @unique
  countryCode        String
  timeZone           String
  currencyCode       String
  nativeLanguage     String?
  administrativeArea String?
  locality           String?
  addressLines       String[]  @default([])
  phone              String?
  website            String?
  creditLabel        String?
  // 시설(주차 · 흡연실 …) — lib/arcadeDetails ARCADE_FACILITIES 의 값
  facilities         String[]  @default([])
  hours              Json?
  hoursVerifiedAt    DateTime?
  hoursValidUntil    DateTime?
  cabinetVerifiedAt  DateTime?
  priceVerifiedAt    DateTime?
  locationVerifiedAt DateTime?
  verificationSource String?
}

model ArcadeCabinet {
  id                 Int                  @id @default(autoincrement())
  arcadeId           Int
  arcade             Arcade               @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  label              String?
  position           Int
  isActive           Boolean              @default(true)
  availability       String               @default("unknown")
  condition          String               @default("unknown")
  // 위치 메모(「안쪽 벽」) — 이름 옆에 보인다
  note               String?
  // 상태 이유(「우측 건반 씹힘」) — 보통·주의일 때 상태 라벨 팝오버로 보인다
  conditionNote      String?              @map("condition_note")
  // 태그(방송기체 · 헤드폰 단자 …) — lib/arcadeDetails ARCADE_CABINET_TAGS 의 값
  tags               String[]             @default([])
  // 특징(정해진 보기 3단계 · 모르면 비움) — ARCADE_CABINET_FEATURES, 그 밖의 이야기는 featureNote(100자)
  keyWeight          String?              @map("key_weight")
  screenLag          String?              @map("screen_lag")
  soundVolume        String?              @map("sound_volume")
  featureNote        String?              @map("feature_note")
  verifiedAt         DateTime?
  validUntil         DateTime?
  verificationSource String?
  reports            FeedbackReport[]
  checks             ArcadeCabinetCheck[]

  @@unique([arcadeId, position])
  @@index([arcadeId, isActive])
}

// 이용자가 「지금 가동 중」 을 한 번 눌러 남기는 기체 확인 기록. 관리자 검증과 별개의 신선도 출처
model ArcadeCabinetCheck {
  id        Int           @id @default(autoincrement())
  cabinetId Int           @map("cabinet_id")
  cabinet   ArcadeCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  userId    Int           @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedAt DateTime      @default(now()) @map("checked_at")

  @@index([cabinetId, checkedAt])
  @@index([userId, checkedAt])
}

model ArcadePublicPhoto {
  id                Int       @id @default(autoincrement())
  arcadeId          Int
  arcade            Arcade    @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  slot              Int
  url               String
  alt               String
  capturedAt        DateTime?
  rightsConfirmedAt DateTime
  publicConsentAt   DateTime

  @@unique([arcadeId, slot])
}

model ArcadeLocalizedIdentity {
  id         Int        @id @default(autoincrement())
  arcadeId   Int
  arcade     Arcade     @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  locale     LocaleCode
  name       String
  aliases    String[]   @default([])
  reviewedAt DateTime

  @@unique([arcadeId, locale])
}

model ArcadeSlugAlias {
  slug     String @id
  arcadeId Int
  arcade   Arcade @relation(fields: [arcadeId], references: [id], onDelete: Cascade)

  @@index([arcadeId])
}

// 방문·API 통계 — 날짜(서울)·종류·열쇠별 합계만 둔다. 90일 뒤 지운다(privacyRetention)
model AnalyticsDailyCount {
  date  DateTime      @db.Date
  kind  AnalyticsKind
  key   String        @default("")
  count Int           @default(0)

  @@id([date, kind, key])
  @@index([kind, date])
  @@map("analytics_daily_counts")
}

// 그날 처음 온 방문자인지만 가리는 해시(그날의 무작위 값 + IP + 브라우저 정보). 다음 날 지운다
model AnalyticsVisitor {
  date DateTime @db.Date
  hash String

  @@id([date, hash])
  @@map("analytics_visitors")
}

// 방문자 해시에 섞는 그날의 무작위 값. 다음 날 지운다
model AnalyticsSalt {
  date DateTime @id @db.Date
  salt String

  @@map("analytics_salts")
}

// 사용자별 이미지 업로드 토큰 발급 횟수를 제한함
model UploadTokenGrant {
  id        Int      @id @default(autoincrement())
  purpose   String
  createdAt DateTime @default(now()) @map("created_at")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

model Music {
  id            Int                @id @default(autoincrement())
  index         String             @unique
  title         String
  titleKana     String             @map("title_kana")
  artist        String?
  category      String
  categoryShort String             @map("category_short")
  description   String?
  license       String?
  unlockType    Int?               @map("unlock_type")
  background    String? // 변수명 jacket으로 변경 필요
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  bingoCovers   Bingo[]            @relation("BingoCoverMusic")
  bingoMissions BingoCell[]        @relation("BingoMissionMusic")
  charts        MusicChart[]
  examStages    ExamStage[]
  examRewards   ExamReward[]
  translations  MusicTranslation[]
  fieldSources  ChartFieldSource[]
}

// 악곡 · 채보 데이터 칸(노트 수 · 공식 레벨 · BPM · 길이 · 수록일 · 해금 조건)에 값을 넣을 때마다 출처를 한 줄씩 쌓음
// source: play_records(사용자 기록 역산) · bemaniwiki · remywiki · manual. 위키 값은 기록으로 다시 구한 값이 생기면 바꿀 수 있다
model ChartFieldSource {
  id         Int                 @id @default(autoincrement())
  chartId    Int?                @map("chart_id")
  chart      MusicChart?         @relation(fields: [chartId], references: [id], onDelete: Cascade)
  musicIndex String?             @map("music_index")
  music      Music?              @relation(fields: [musicIndex], references: [index], onDelete: Cascade)
  field      String
  value      String
  source     String
  sourceUrl  String?             @map("source_url")
  note       String?
  // 유저 기여로 반영된 값이면 그 제안(누가 · 근거) — 「출처 보기」 가 여기로 이어진다(2026-09-23)
  proposalId Int?                @unique @map("proposal_id")
  proposal   ChartFieldProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([chartId, field])
  @@index([musicIndex, field])
  @@map("chart_field_sources")
}

// 유저가 제안한 채보 정보 값(BPM · 노트 수 · 길이 · 수록일) — 운영자가 반영하거나 사유와 함께 반려한다(2026-09-23)
// 같은 사람 · 같은 채보 · 같은 칸의 대기 중 제안은 하나 — 다시 내면 값을 바꾼다
model ChartFieldProposal {
  id               Int                   @id @default(autoincrement())
  userId           Int                   @map("user_id")
  user             User                  @relation("ChartFieldProposalAuthor", fields: [userId], references: [id], onDelete: Cascade)
  chartId          Int                   @map("chart_id")
  chart            MusicChart            @relation(fields: [chartId], references: [id], onDelete: Cascade)
  // bpm | note_count | duration | released_at
  field            String
  // 제안 값 — BPM 「60」 · 「60-120」, 노트 수 정수, 길이 초, 수록일 YYYY-MM-DD
  value            String
  // 제안할 때 화면에 있던 값(비어 있었으면 null) — 그 사이 값이 바뀌었는지 검토에서 본다
  previousValue    String?               @map("previous_value")
  // video | official | direct
  evidenceKind     ProposalEvidenceKind  @map("evidence_kind")
  evidenceUrl      String?               @map("evidence_url")
  evidenceNote     String?               @map("evidence_note")
  // pending | applied | rejected | withdrawn
  status           ProposalStatus        @default(pending)
  // 반려 사유 — 정해진 코드(evidence | url | duplicate | format | other)와 덧붙인 말(2026-10-01 D2)
  rejectReasonCode ProposalRejectReason? @map("reject_reason_code")
  reviewNote       String?               @map("reject_reason")
  // 운영자가 값을 고쳐 반영했으면 그 값 — 제안 값과 다르면 기여자에게 그대로 보여 준다(2026-10-01 C2)
  appliedValue     String?               @map("applied_value")
  // 기여자가 처리 결과를 본 시각 — 「새 결과」 점(2026-10-01 A2)
  authorSeenAt     DateTime?             @map("seen_at")
  reviewedById     Int?                  @map("reviewed_by_id")
  reviewedBy       User?                 @relation("ChartFieldProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?             @map("reviewed_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  source           ChartFieldSource?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([chartId, field, status])
  @@index([reviewedById])
  // 스키마 밖 — "chart_field_proposals_one_pending": (user_id, chart_id, field) WHERE status = 'pending'.
  // 같은 사람 · 채보 · 칸의 대기 중 제안은 하나(위 주석의 규칙). 존재는 tests/schema-objects-database.test.ts 가 확인한다
  @@map("chart_field_proposals")
}

// 유저별 채보 초안(2026-09-24 3단계) — 한 사람 · 한 채보에 하나. 작성자와 운영자만 본다.
// status: draft(작성 중) · submitted(검토 요청) · changes_requested(수정 요청) · published(공개됨 — 다시 고치면 draft)
model ChartDraft {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  user         User             @relation("ChartDraftAuthor", fields: [userId], references: [id], onDelete: Cascade)
  chartId      Int              @map("chart_id")
  chart        MusicChart       @relation(fields: [chartId], references: [id], onDelete: Cascade)
  content      Json
  // 자동 저장 충돌 방지 — 관리자 에디터의 draftVersion 과 같은 방식
  version      Int              @default(0)
  status       ChartDraftStatus @default(draft)
  // 공개본에서 시작했으면 그 공개 버전 — 검토 때 「공개본 대비」 비교
  baseRevision Int?             @map("base_revision")
  submittedAt  DateTime?        @map("submitted_at")
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewedById Int?             @map("reviewed_by_id")
  reviewedBy   User?            @relation("ChartDraftReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt  DateTime?        @map("published_at")
  // 작성자가 검토 결과(수정 요청 · 공개)를 본 시각 — 「새 결과」 점(2026-10-01 A2)
  authorSeenAt DateTime?        @map("seen_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  comments     ChartComment[]

  @@unique([userId, chartId])
  @@index([status, submittedAt])
  @@index([chartId])
  @@index([reviewedById])
  @@map("chart_drafts")
}

// 채보 시각 댓글(2026-09-24 3단계) — 초안 검토(draftId 있음 · 작성자와 운영자만) 또는 공개 채보(draftId 없음 · 누구나 읽음).
// 「해결」 은 운영자만, 공개 채보 댓글이 해결되면 쓴 사람에게 기여 1점
model ChartComment {
  id           Int              @id @default(autoincrement())
  chartId      Int              @map("chart_id")
  chart        MusicChart       @relation(fields: [chartId], references: [id], onDelete: Cascade)
  draftId      Int?             @map("draft_id")
  draft        ChartDraft?      @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId       Int              @map("user_id")
  user         User             @relation("ChartCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  timeMs       Int              @map("time_ms")
  // problem | suggestion | praise — 무엇이 고칠 것인지 한눈에(2026-10-01 H2, osu! 글쓰기 3종)
  kind         ChartCommentKind @default(problem)
  body         String
  resolved     Boolean          @default(false)
  resolvedAt   DateTime?        @map("resolved_at")
  resolvedById Int?             @map("resolved_by_id")
  resolvedBy   User?            @relation("ChartCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // 운영자가 가린 댓글(신고 · 장난 대응) — 목록에서 빠진다
  hidden       Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([chartId, draftId, timeMs])
  @@index([draftId])
  @@index([userId, createdAt])
  @@index([resolvedById])
  @@map("chart_comments")
}

// 기여 점수 기록 — 반영 · 처리된 기여마다 한 줄(2026-09-24). 원본(제보 등)이 보관 기간으로 지워져도 점수는 남는다.
// kind: chart_field(제안 번호) · arcade_report(제보 번호) · cabinet_check(서울 날짜, 하루 1점). 같은 기여는 한 번만
model ContributionPoint {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ContributionKind
  sourceKey String           @map("source_key")
  points    Int
  createdAt DateTime         @default(now()) @map("created_at")

  // userId 만으로 찾는 질의는 위 유일 키 앞부분이 맡는다(2026-10-16 P2 — 따로 둔 [userId] 인덱스는 뺐다)
  @@unique([userId, kind, sourceKey])
  @@map("contribution_points")
}

// 해금 조건 원문(이벤트 · 곡 묶음 이름, 일본어)의 언어별 번역 사전 — 이름 하나를 한 번만 번역한다
model UnlockConditionTranslation {
  id         Int      @id @default(autoincrement())
  sourceText String   @map("source_text")
  locale     String
  text       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([sourceText, locale])
  @@map("unlock_condition_translations")
}

// 검수 상태를 포함한 악곡 번역 제목을 언어별로 관리함
model MusicTranslation {
  id         Int                    @id @default(autoincrement())
  musicIndex String                 @map("music_index")
  locale     LocaleCode
  title      String
  status     MusicTranslationStatus @default(draft)
  reviewedAt DateTime?              @map("reviewed_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  music      Music                  @relation(fields: [musicIndex], references: [index], onDelete: Cascade)

  @@unique([musicIndex, locale])
  @@index([locale, status, title])
}

// 사용자 연동에서 감지한 공식 악곡 카탈로그 변경 후보와 처리 이력을 보존함
model MusicCatalogCandidate {
  id             Int                    @id @default(autoincrement())
  musicIndex     String                 @map("music_index")
  fingerprint    String
  payload        Json
  beforeSnapshot Json?                  @map("before_snapshot")
  status         CatalogCandidateStatus @default(pending)
  seenCount      Int                    @default(1) @map("seen_count")
  lastSeenAt     DateTime               @default(now()) @map("last_seen_at")
  reviewedAt     DateTime?              @map("reviewed_at")
  appliedAt      DateTime?              @map("applied_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@unique([musicIndex, fingerprint])
  @@index([status, lastSeenAt])
}

// 악곡별 채보 정보를 난이도 컬럼과 분리해 관리함
model MusicChart {
  id              Int             @id @default(autoincrement())
  difficulty      ChartDifficulty
  level           Int
  levelConstant   Float?          @map("level_constant")
  bpmMin          Int?            @map("bpm_min")
  bpmMax          Int?            @map("bpm_max")
  noteCount       Int?            @map("note_count")
  durationSeconds Int?            @map("duration_seconds")
  releasedAt      DateTime?       @map("released_at")
  unlockCondition String?         @map("unlock_condition")
  playVideoUrl    String?         @map("play_video_url")
  chartPreviewUrl String?         @map("chart_preview_url")
  musicIdx        String          @map("music_idx")
  music           Music           @relation(fields: [musicIdx], references: [index], onDelete: Cascade)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  levelConstantHistory ChartLevelConstantHistory[]
  fieldSources         ChartFieldSource[]
  communityEvaluations CommunityChartEvaluation[]
  goalVotes            ChartGoalVote[]
  goalVoteAudit        ChartGoalVoteAudit[]
  playData             PlayData[]
  playHistory          ChartPlayHistory[]
  recordSnapshots      ChartRecordSnapshot[]
  examStageOptions     ExamStageChart[]
  tierEntries          TierEntry[]
  tierPlacementHistory TierPlacementHistory[]
  pattern              ChartPattern?
  fieldProposals       ChartFieldProposal[]
  drafts               ChartDraft[]
  comments             ChartComment[]
  pinnedBy             UserPinnedRecord[]

  @@unique([musicIdx, difficulty])
  @@index([level])
  @@index([levelConstant])
}

// 악곡 채보 편집기의 현재 초안과 공개 스냅샷을 관리함
model ChartPattern {
  id                Int                    @id @default(autoincrement())
  chartId           Int                    @unique @map("chart_id")
  chart             MusicChart             @relation(fields: [chartId], references: [id], onDelete: Cascade)
  formatVersion     Int                    @default(1) @map("format_version")
  draftContent      Json                   @map("draft_content")
  publishedContent  Json?                  @map("published_content")
  draftVersion      Int                    @default(0) @map("draft_version")
  savedRevision     Int                    @default(0) @map("saved_revision")
  publishedRevision Int?                   @map("published_revision")
  createdById       Int?                   @map("created_by_id")
  createdBy         User?                  @relation("ChartPatternCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById       Int?                   @map("updated_by_id")
  updatedBy         User?                  @relation("ChartPatternUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedById     Int?                   @map("published_by_id")
  publishedBy       User?                  @relation("ChartPatternPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  // 유저 초안을 공개한 채보의 실제 작성자(2026-09-24 3단계) — 비어 있으면 작성자 줄은 공개한 사람
  authorId          Int?                   @map("author_id")
  author            User?                  @relation("ChartPatternAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt       DateTime?              @map("published_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  revisions         ChartPatternRevision[]

  @@index([publishedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([publishedById])
  @@index([authorId])
}

// 명시적 저장과 공개 시점의 채보 문서를 복구 가능한 버전으로 보존함
model ChartPatternRevision {
  id          Int                      @id @default(autoincrement())
  patternId   Int                      @map("pattern_id")
  pattern     ChartPattern             @relation(fields: [patternId], references: [id], onDelete: Cascade)
  number      Int
  kind        ChartPatternRevisionKind @default(manual)
  message     String?
  content     Json
  createdById Int?                     @map("created_by_id")
  createdBy   User?                    @relation("ChartPatternRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                 @default(now()) @map("created_at")

  @@unique([patternId, number])
  @@index([patternId, createdAt])
  @@index([createdById])
}

// 유저의 데이터 연동 실행 단위와 처리 결과를 관리함
model DataSync {
  id              Int                   @id @default(autoincrement())
  status          DataSyncStatus        @default(processing)
  syncScope       SyncScope             @default(full) @map("sync_scope")
  receivedPlays   Int                   @default(0) @map("received_plays")
  insertedPlays   Int                   @default(0) @map("inserted_plays")
  changedRecords  Int                   @default(0) @map("changed_records")
  errorMessage    String?               @map("error_message")
  userId          Int                   @map("user_id")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime              @default(now()) @map("started_at")
  completedAt     DateTime?             @map("completed_at")
  playHistory     ChartPlayHistory[]
  recordSnapshots ChartRecordSnapshot[]
  ratingHistory   UserRatingHistory[]
  // 스키마 밖(Prisma 6 은 부분 인덱스를 쓰지 못함) — "DataSync_one_processing_per_user": user_id WHERE status = 'processing'.
  // 사람당 처리 중 동기화는 하나. 존재는 tests/schema-objects-database.test.ts 가 확인한다

  @@index([userId, startedAt])
  // 관리자 대시보드 · 동기화 목록(상태별 최근순, 2026-10-16 P2)
  @@index([status, startedAt])
}

// 공식 최근 플레이 응답을 중복 없이 누적해 점수 추이에 사용함
model ChartPlayHistory {
  id            Int        @id @default(autoincrement())
  level         Int?
  score         Int
  bestScore     Int?       @map("best_score")
  maxCombo      Int        @map("max_combo")
  rank          String
  gradeBasic    Int        @map("grade_basic")
  classBasic    String?    @map("class_basic")
  fastCount     Int?       @map("fast_count")
  slowCount     Int?       @map("slow_count")
  isOnehand     Boolean?   @map("is_onehand")
  judgeSjust    Int?       @map("judge_sjust")
  judgeJust     Int?       @map("judge_just")
  judgeGood     Int?       @map("judge_good")
  judgeMiss     Int?       @map("judge_miss")
  judgeNear     Int?       @map("judge_near")
  // 플레이 시각(공식 KST 시각을 timestamptz 로) — 같은 플레이를 가르는 유일 키의 일부
  playedAt      DateTime   @map("played_at") @db.Timestamptz(3)
  chartId       Int        @map("chart_id")
  chart         MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  userId        Int        @map("user_id")
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordApplied Boolean    @default(false) @map("record_applied")
  firstSyncId   Int?       @map("first_sync_id")
  firstSync     DataSync?  @relation(fields: [firstSyncId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now()) @map("created_at")

  // 같은 플레이 하나(2026-10-16 P5-1 — 문자열 시각 키에서 played_at 으로)
  @@unique([userId, chartId, playedAt, score, maxCombo, rank])
  // 최근 플레이 목록(사람별 최신순)
  @@index([userId, playedAt(sort: Desc), id(sort: Desc)])
  @@index([firstSyncId])
  @@index([userId, recordApplied])
  // 외래 키 — 채보를 지울 때 표 전체를 훑지 않게. 큰 표라 CONCURRENTLY 단독 마이그레이션으로 만든다(2026-10-16 P2)
  @@index([chartId])
}

// 전체·최근 연동에서 개인 기록이 변경된 시점의 상태를 저장함
model ChartRecordSnapshot {
  id                Int        @id @default(autoincrement())
  level             Int
  score             Int
  rank              String
  fcType            Int        @map("fc_type")
  playCount         Int        @map("play_count")
  clearCount        Int?       @map("clear_count")
  clearFlag         Int?       @map("clear_flag")
  fullcomboCount    Int        @map("fullcombo_count")
  pianisticCount    Int        @map("pianistic_count")
  maxCombo          Int        @map("max_combo")
  gradeBasic        Int        @map("grade_basic")
  gradeRecital      Int?       @map("grade_recital")
  judgeSjust        Int?       @map("judge_sjust")
  judgeJust         Int?       @map("judge_just")
  judgeGood         Int?       @map("judge_good")
  judgeMiss         Int?       @map("judge_miss")
  judgeNear         Int?       @map("judge_near")
  noteRateStandard  Int?       @map("note_rate_standard")
  noteRateTenuto    Int?       @map("note_rate_tenuto")
  noteRateGlissando Int?       @map("note_rate_glissando")
  noteRateTrill     Int?       @map("note_rate_trill")
  // PlayData.bestAt 과 같은 뜻
  bestAt            DateTime?  @map("best_at") @db.Timestamptz(3)
  chartId           Int        @map("chart_id")
  chart             MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  userId            Int        @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncId            Int        @map("sync_id")
  sync              DataSync   @relation(fields: [syncId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now()) @map("created_at")

  @@unique([syncId, chartId])
  @@index([userId, chartId, createdAt])
  // 외래 키 — 위와 같은 이유, CONCURRENTLY 단독 마이그레이션(2026-10-16 P2)
  @@index([chartId])
}

// 공식 레벨 상수 변경 이력을 시점별로 관리함
model ChartLevelConstantHistory {
  id          Int        @id @default(autoincrement())
  value       Float
  effectiveAt DateTime   @default(now()) @map("effective_at")
  chartId     Int        @map("chart_id")
  chart       MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([chartId, effectiveAt])
  @@map("ChartConstantHistory")
}

// Basic/Recital 등 독립된 서열표의 공개 상태와 구성을 관리함
model TierList {
  id          Int                    @id @default(autoincrement())
  slug        String                 @unique
  title       String
  mode        PlayMode
  // 목표 값 목록은 CHECK 로 지킨다(s · fc · 990k · pianist — fc 는 보관된 옛 Recital FC 표). 990k 가 enum 이름이 될 수 없어 enum 이 아니다(2026-10-16 K2)
  goal        String?
  description String?
  status      TierListStatus         @default(draft)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  bands       TierBand[]
  entries     TierEntry[]
  history     TierPlacementHistory[]

  @@index([mode, goal, status, updatedAt])
}

// 서열표 안의 12.9, 12.8 같은 상수 구간을 관리함
model TierBand {
  id         Int         @id @default(autoincrement())
  value      Float
  position   Int
  tierListId Int         @map("tier_list_id")
  tierList   TierList    @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  entries    TierEntry[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([tierListId, value])
  @@unique([tierListId, position])
}

// 채보가 어느 서열표 구간의 몇 번째에 배치되는지 관리함
model TierEntry {
  id         Int        @id @default(autoincrement())
  position   Int
  tierListId Int        @map("tier_list_id")
  tierList   TierList   @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  tierBandId Int        @map("tier_band_id")
  tierBand   TierBand   @relation(fields: [tierBandId], references: [id], onDelete: Cascade)
  chartId    Int        @map("chart_id")
  chart      MusicChart @relation(fields: [chartId], references: [id], onDelete: Restrict)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@unique([tierListId, chartId])
  @@unique([tierBandId, position])
  @@index([tierListId, tierBandId])
  @@index([chartId])
}

// 채보의 서열표 구간 이동과 제거 이력을 보존함
model TierPlacementHistory {
  id          Int        @id @default(autoincrement())
  bandValue   Float?     @map("band_value")
  effectiveAt DateTime   @default(now()) @map("effective_at")
  tierListId  Int        @map("tier_list_id")
  tierList    TierList   @relation(fields: [tierListId], references: [id], onDelete: Cascade)
  chartId     Int        @map("chart_id")
  chart       MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([tierListId, chartId, effectiveAt])
  @@index([chartId, effectiveAt])
}

// 2.0 패턴 평가는 기존 ChartEvaluation의 서로 다른 축 값을 재해석하지 않음.
model CommunityChartEvaluation {
  id                  Int                       @id @default(autoincrement())
  chartId             Int
  userId              Int
  stairs              Int?
  repetition          Int?
  polyrhythm          Int?
  offset              Int?
  chords              Int?
  opinion             String?
  opinionHidden       Boolean                   @default(false)
  excluded            Boolean                   @default(false)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  opinionUpdatedAt    DateTime?
  opinionCreatedAt    DateTime?
  // 처음 누를 때 만든 번역 { ko?, ja?, en? } — 글을 고치면 비운다. 글 언어는 읽을 때 글자 종류로 판별(2026-09-22)
  opinionTranslations Json?
  chart               MusicChart                @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful             CommunityOpinionHelpful[]
  reports             CommunityOpinionReport[]
  replies             CommunityOpinionReply[]

  @@unique([chartId, userId])
  @@index([chartId, excluded, opinionUpdatedAt])
  @@index([userId, excluded])
}

model CommunityOpinionHelpful {
  // 외래 키가 복합 기본 키(@@id)의 앞 칸이라 이미 인덱스가 있다 — prisma-lint 가 @@id 를 인덱스로 보지 않는다
  /// prisma-lint-ignore-model require-field-index
  evaluationId Int
  userId       Int
  createdAt    DateTime                 @default(now())
  evaluation   CommunityChartEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([evaluationId, userId])
  @@index([userId])
}

model CommunityOpinionReport {
  id              Int                       @id @default(autoincrement())
  evaluationId    Int?
  // 답글 신고면 답글 번호(2026-09-22). 의견 신고는 null
  replyId         Int?
  userId          Int
  authorId        Int
  opinionSnapshot String
  reason          OpinionReportReason
  explanation     String?
  status          String                    @default("pending")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  evaluation      CommunityChartEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  reply           CommunityOpinionReply?    @relation(fields: [replyId], references: [id], onDelete: SetNull)
  user            User                      @relation("CommunityReportReporter", fields: [userId], references: [id], onDelete: Cascade)
  author          User                      @relation("CommunityReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, userId])
  @@unique([replyId, userId])
  @@index([status, createdAt])
  // 외래 키 — 탈퇴 연쇄 삭제 · 설정 화면 개수(2026-10-16 P2)
  @@index([userId])
  @@index([authorId])
}

// 의견에 다는 답글(2026-09-22 R1 — 한 단계). 답글에 답할 때는 본문 앞에 @이름을 붙인다
model CommunityOpinionReply {
  id           Int                         @id @default(autoincrement())
  evaluationId Int
  userId       Int
  body         String
  // 답글 번역 — 의견과 같은 방식(2026-09-22)
  translations Json?
  hidden       Boolean                     @default(false)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  evaluation   CommunityChartEvaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        CommunityOpinionReplyLike[]
  reports      CommunityOpinionReport[]

  @@index([evaluationId, createdAt])
  @@index([userId])
}

model CommunityOpinionReplyLike {
  // 외래 키가 복합 기본 키(@@id)의 앞 칸이라 이미 인덱스가 있다 — prisma-lint 가 @@id 를 인덱스로 보지 않는다
  /// prisma-lint-ignore-model require-field-index
  replyId   Int
  userId    Int
  createdAt DateTime              @default(now())
  reply     CommunityOpinionReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([replyId, userId])
  @@index([userId])
}

// 목표 투표는 관리자 서열표 버전 및 일반 패턴 평가와 독립적으로 유지함.
model ChartGoalVote {
  id        Int        @id @default(autoincrement())
  chartId   Int
  userId    Int
  mode      PlayMode
  // 목표 값 목록은 CHECK 로 지킨다(s · fc · 990k · pianist — fc 는 보관된 옛 Recital FC 표). 990k 가 enum 이름이 될 수 없어 enum 이 아니다(2026-10-16 K2)
  goal      String
  value     Float
  excluded  Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chart     MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chartId, userId, mode, goal])
  @@index([chartId, mode, goal, excluded, value])
  // 외래 키 — 탈퇴 연쇄 삭제 · 설정 화면 개수(2026-10-16 P2)
  @@index([userId])
}

model ChartGoalVoteAudit {
  id            Int                 @id @default(autoincrement())
  chartId       Int
  userId        Int
  mode          PlayMode
  // 목표 값 목록은 CHECK 로 지킨다(s · fc · 990k · pianist — fc 는 보관된 옛 Recital FC 표). 990k 가 enum 이름이 될 수 없어 enum 이 아니다(2026-10-16 K2)
  goal          String
  action        GoalVoteAuditAction
  previousValue Float?
  value         Float?
  evidence      Json
  createdAt     DateTime            @default(now())
  chart         MusicChart          @relation(fields: [chartId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chartId, mode, goal, createdAt])
  @@index([userId])
}

model UserBestGrade {
  id           Int      @id @default(autoincrement())
  gradeBasic   Int      @map("grade_basic")
  gradeRecital Int?     @map("grade_recital")
  // 그 날짜(서울 날짜)
  day          DateTime @map("day") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 사람당 하루 한 줄 — 코드 규칙을 DB 도 지킨다(2026-10-16 DB 재설계 P2, P5-1 에서 day 로)
  @@unique([userId, day])
}

// 실제 동기화 시점의 레이팅을 보관하며 과거 값을 소급 추정하지 않음
model UserRatingHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncId     Int      @map("sync_id")
  sync       DataSync @relation(fields: [syncId], references: [id], onDelete: Cascade)
  mode       PlayMode
  rating     Float
  observedAt DateTime @default(now()) @map("observed_at")

  @@unique([syncId, mode])
  @@index([userId, mode, observedAt])
}

model PlayData {
  id                Int        @id @default(autoincrement())
  level             Int
  score             Int
  rank              String
  fcType            Int        @map("fc_type")
  playCount         Int        @map("play_count")
  clearCount        Int?       @map("clear_count")
  clearFlag         Int?       @map("clear_flag")
  fullcomboCount    Int        @map("fullcombo_count")
  pianisticCount    Int        @map("pianistic_count")
  maxCombo          Int        @map("max_combo")
  gradeBasic        Int        @map("grade_basic")
  gradeRecital      Int?       @map("grade_recital")
  judgeSjust        Int?       @map("judge_sjust")
  judgeJust         Int?       @map("judge_just")
  judgeGood         Int?       @map("judge_good")
  judgeMiss         Int?       @map("judge_miss")
  judgeNear         Int?       @map("judge_near")
  noteRateStandard  Int?       @map("note_rate_standard")
  noteRateTenuto    Int?       @map("note_rate_tenuto")
  noteRateGlissando Int?       @map("note_rate_glissando")
  noteRateTrill     Int?       @map("note_rate_trill")
  // 기록 시각(KST 공식 시각을 timestamptz 로, 모르면 NULL — 옛 「1970-01-01 09:00」 자리표시도 NULL)
  bestAt            DateTime?  @map("best_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  userId            Int        @map("user_id")
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 기록은 채보에 묶인다(2026-10-16 D2-B) — 기록이 있는 채보는 지우지 못한다(앱에 채보 삭제 경로는 없음)
  chartId           Int        @map("chart_id")
  chart             MusicChart @relation(fields: [chartId], references: [id], onDelete: Restrict)

  @@unique([userId, chartId])
  @@index([chartId, score, userId])
  @@index([userId, gradeBasic])
  @@index([userId, gradeRecital])
}

model Bingo {
  id                  Int         @id @default(autoincrement())
  title               String?
  description         String?
  sourceVersion       String?     @map("source_version")
  rewardNos           Int         @map("nos")
  lineRewardNos       Int         @default(0) @map("line_reward_nos")
  completionRewardNos Int         @default(0) @map("completion_reward_nos")
  requiredLines       Int         @map("line")
  status              BingoStatus @default(draft)
  startsAt            DateTime?   @map("starts_at")
  endsAt              DateTime?   @map("ends_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  coverMusicIndex     String      @map("music_idx")
  coverMusic          Music       @relation("BingoCoverMusic", fields: [coverMusicIndex], references: [index], onDelete: Restrict)
  cells               BingoCell[]

  @@index([status, startsAt, endsAt])
  @@index([coverMusicIndex])
}

model BingoCell {
  id               Int                 @id @default(autoincrement())
  position         Int // 칸 위치(1~25)
  title            String              @map("challenge")
  missionType      BingoMissionType    @default(record) @map("mission_type")
  ruleType         BingoRuleType       @default(manual) @map("rule_type")
  ruleConfig       Json?               @map("rule_config")
  categoryShort    String?             @map("category_short")
  targetDifficulty BingoDifficulty?    @map("target_difficulty")
  targetLevel      Int?                @map("target_level")
  musicIndex       String?             @map("music_idx")
  music            Music?              @relation("BingoMissionMusic", fields: [musicIndex], references: [index], onDelete: SetNull)
  bingoId          Int                 @map("bingo_id")
  bingo            Bingo               @relation(fields: [bingoId], references: [id], onDelete: Cascade)
  progress         BingoCellProgress[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([bingoId, position])
  @@index([musicIndex])
}

model BingoCellProgress {
  id               Int       @id @default(autoincrement())
  isCompleted      Boolean   @default(false) @map("isCompleted")
  completionSource String    @default("manual") @map("completion_source")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  userId           Int       @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bingoCellId      Int       @map("bingo_cell_id")
  // 진행 기록이 있는 빙고는 지우지 않는다 — 앱 규칙을 DB 도 지킨다(2026-10-16 P2, 예전 Cascade)
  cell             BingoCell @relation(fields: [bingoCellId], references: [id], onDelete: Restrict)

  @@unique([userId, bingoCellId])
  @@index([bingoCellId])
  @@map("userBingoCellData")
}

// 검정 모드별 급수와 응시 조건을 관리함
model Exam {
  id            Int               @id @default(autoincrement())
  slug          String            @unique
  mode          ExamMode
  shortLabel    String            @map("short_label")
  scoringType   ExamScoringType   @default(score) @map("scoring_type")
  grade         Int?
  title         String
  description   String?
  feeNos        Int               @default(0) @map("fee_nos")
  requiredGrade Int               @default(0) @map("required_grade")
  status        ExamStatus        @default(draft)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  stages        ExamStage[]
  rewards       ExamReward[]
  submissions   ExamSubmission[]
  achievements  ExamAchievement[]

  @@unique([mode, grade])
  @@index([status])
}

// 검정의 과제곡과 단계별 통과 조건을 관리함
model ExamStage {
  id              Int                 @id @default(autoincrement())
  position        Int
  label           String?
  requirementType ExamRequirementType @default(single) @map("requirement_type")
  requiredValue   Float               @map("required_value")
  examId          Int                 @map("exam_id")
  exam            Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  musicIndex      String              @map("music_idx")
  music           Music               @relation(fields: [musicIndex], references: [index], onDelete: Restrict)
  allowedCharts   ExamStageChart[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([examId, position])
  @@index([musicIndex])
}

// 이벤트 검정 등에서 한 과제곡에 허용되는 여러 난이도 채보를 관리함
model ExamStageChart {
  // 외래 키가 복합 기본 키(@@id)의 앞 칸이라 이미 인덱스가 있다 — prisma-lint 가 @@id 를 인덱스로 보지 않는다
  /// prisma-lint-ignore-model require-field-index
  stageId Int        @map("stage_id")
  stage   ExamStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  chartId Int        @map("chart_id")
  chart   MusicChart @relation(fields: [chartId], references: [id], onDelete: Restrict)

  @@id([stageId, chartId])
  @@index([chartId])
}

// 검정 합격 보상을 복수 악곡까지 지원하도록 관리함
model ExamReward {
  id         Int            @id @default(autoincrement())
  position   Int
  type       ExamRewardType
  label      String?
  examId     Int            @map("exam_id")
  exam       Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  musicIndex String?        @map("music_idx")
  music      Music?         @relation(fields: [musicIndex], references: [index], onDelete: Restrict)

  @@unique([examId, position])
  @@index([musicIndex])
}

// 사용자가 제출한 합격 증빙과 심사 상태를 관리함
model ExamSubmission {
  id            Int                  @id @default(autoincrement())
  proofImageUrl String?              @map("proof_image_url")
  status        ExamSubmissionStatus @default(pending)
  reviewNote    String?              @map("reviewer_note")
  submittedAt   DateTime             @default(now()) @map("submitted_at")
  reviewedAt    DateTime?            @map("reviewed_at")
  // 승인 · 반려한 운영자(2026-10-16 D5) — 이 날 전 기록은 비어 있다
  reviewedById  Int?                 @map("reviewed_by_id")
  reviewedBy    User?                @relation("ExamSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  userId        Int                  @map("user_id")
  user          User                 @relation("ExamSubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  examId        Int                  @map("exam_id")
  // 인증 이력이 있는 검정은 지우지 않는다 — 앱 규칙을 DB 도 지킨다(2026-10-16 P2, 예전 Cascade)
  exam          Exam                 @relation(fields: [examId], references: [id], onDelete: Restrict)
  achievement   ExamAchievement?
  // 스키마 밖 — "ExamSubmission_one_pending": (user_id, exam_id) WHERE status = 'pending'(2026-10-16 D5)

  @@index([userId, examId, submittedAt])
  @@index([status, submittedAt])
  @@index([examId])
  @@index([reviewedById])
}

// 승인된 검정 급수를 사용자별로 정규화해 보관함
model ExamAchievement {
  id           Int            @id @default(autoincrement())
  achievedAt   DateTime       @default(now()) @map("achieved_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  userId       Int            @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId       Int            @map("exam_id")
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Restrict)
  submissionId Int            @unique @map("submission_id")
  submission   ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([examId, achievedAt])
}

// 공식 X 최신 원문·번역과 12시간 실행 중복 방지 상태. 홈에서는 읽기만 한다.
model OfficialXFeed {
  id            String    @id
  content       Json?
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastSuccessAt DateTime? @map("last_success_at")
}

// 업적 단계 획득 기록(2026-09-24). 업적 정의(키 · 기준)는 코드(features/achievements)에 둔다.
// 동기화 때 판정해 새 단계만 더한다. 기준을 넘었다가 내려가도 지우지 않는다. 날짜는 NosLog 가 확인한 때
model UserAchievement {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  // 1 동 · 2 은 · 3 금
  tier       Int
  achievedAt DateTime @default(now()) @map("achieved_at")

  @@unique([userId, key, tier])
  @@index([key, tier])
}

// 프로필 머리에 거는 업적(최대 3칸). 비어 있으면 높은 단계를 자동으로 보인다
model UserAchievementShowcase {
  userId   Int    @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 1~3
  position Int
  key      String

  @@id([userId, position])
  @@unique([userId, key])
}

// 동기화가 계산해 두는 사람별 값(2026-10-16 DB 재설계 D2-B). 예전에는 User 에 섞여 있었다 —
// 로그인한 모든 요청이 읽고 동기화 동안 잠그는 User 행을 작게 두려고 옮긴다. 지금은 늘리기 단계라
// 동기화가 User 의 같은 열과 이 표에 함께 쓰고(양쪽 쓰기), 읽기는 아직 User 다(P4 에서 전환).
// 「score*」 = 그 랭크로 끝낸 채보 수(scoreF 는 풀콤보 수). 값의 뜻은 User 의 같은 이름 열과 같다
model PlayerStats {
  userId           Int       @id @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeBasic       Int?      @map("grade_basic")
  gradeRecital     Int?      @map("grade_recital")
  scoreP           Int?      @map("score_p")
  scoreF           Int?      @map("score_f")
  scoreS           Int?      @map("score_s")
  scoreA2          Int?      @map("score_a2")
  scoreA           Int?      @map("score_a")
  scoreB2          Int?      @map("score_b2")
  scoreB           Int?      @map("score_b")
  scoreC           Int?      @map("score_c")
  scoreD           Int?      @map("score_d")
  // 공식 플레이 횟수 · 마지막 플레이(공식 사이트 시각, KST 를 timestamptz 로)
  playCount        Int?      @map("play_count")
  lastPlayedAt     DateTime? @map("last_played_at") @db.Timestamptz(3)
  lastFullRecordAt DateTime? @map("last_full_record_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([gradeBasic])
  @@index([gradeRecital])
  @@map("player_stats")
}

// 레이팅 랭킹용 — 사람 · 모드마다 동기화 때 계산해 둔 값(2026-10-15 L2-A2).
// 랭킹은 이 값을 정렬해 한 쪽만 읽는다. 값은 calculateBasicRating 결과 그대로(표시할 때 반올림)
// basis_version = 계산식 판 + 피아니스트 서열 상수의 지문. 기준이 바뀌면 전원을 한 트랜잭션으로 다시 써서
// 다 셀 때까지는 옛 값을 보여 주고, 옛 값과 새 값이 섞이지 않게 한다
model PlayerRating {
  // 외래 키가 복합 기본 키(@@id)의 앞 칸이라 이미 인덱스가 있다 — prisma-lint 가 @@id 를 인덱스로 보지 않는다
  /// prisma-lint-ignore-model require-field-index
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // basic | recital
  mode         PlayMode
  rating       Float
  filledSlots  Int      @map("filled_slots")
  basisVersion String   @map("basis_version")
  computedAt   DateTime @default(now()) @map("computed_at")

  @@id([userId, mode])
  @@index([mode, rating(sort: Desc)])
}

// 프로필 개요에 고정한 기록(최대 3칸 · 한 줄 소감, 2026-09-26 S2). 비어 있으면 베스트 상위 3곡을 보인다.
// 동기화 때마다 기록 행이 바뀔 수 있어 채보 기준으로 고정한다
model UserPinnedRecord {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  chartId   Int        @map("chart_id")
  chart     MusicChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  // 1~3
  position  Int
  comment   String?    @db.VarChar(80)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@unique([userId, position])
  @@unique([userId, chartId])
  @@index([chartId])
}

