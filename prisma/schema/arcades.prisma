// 오락실 · 기체 · 공개 정보

// 유저가 선택할 수 있는 오락실 목록을 관리자 데이터로 관리함
model Arcade {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  latitude      Float?
  longitude     Float?
  playPrice     Int?     @map("play_price")
  coinCount     Int?     @map("coin_count")
  businessHours Json?    @map("business_hours")
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  users         User[]

  publicDetails ArcadePublicDetails?
  cabinets      ArcadeCabinet[]
  publicPhotos  ArcadePublicPhoto[]
  // 줄이기 1단계(2026-10-17) — 넣는 곳이 없어 비어 있던 두 표. 코드는 읽지 않고 다음 배포에서 DROP
  identities    ArcadeLocalizedIdentity[] @ignore
  slugAliases   ArcadeSlugAlias[]         @ignore
  reports       FeedbackReport[]

  @@index([isActive, name])
  @@map("arcades")
}

// Optional verified public facts; legacy editor fields remain intact.
model ArcadePublicDetails {
  arcadeId           Int       @id @map("arcade_id")
  arcade             Arcade    @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  slug               String    @unique
  countryCode        String    @map("country_code")
  timeZone           String    @map("time_zone")
  currencyCode       String    @map("currency_code")
  nativeLanguage     String?   @map("native_language")
  administrativeArea String?   @map("administrative_area")
  locality           String?
  addressLines       String[]  @default([]) @map("address_lines")
  phone              String?
  website            String?
  creditLabel        String?   @map("credit_label")
  // 시설(주차 · 흡연실 …) — lib/arcadeDetails ARCADE_FACILITIES 의 값
  facilities         String[]  @default([])
  hours              Json?
  hoursVerifiedAt    DateTime? @map("hours_verified_at")
  hoursValidUntil    DateTime? @map("hours_valid_until")
  cabinetVerifiedAt  DateTime? @map("cabinet_verified_at")
  // 줄이기 1단계(2026-10-17) — 만든 뒤로 읽고 쓰는 곳이 없던 칸. 다음 배포에서 DROP
  priceVerifiedAt    DateTime? @map("price_verified_at") @ignore
  locationVerifiedAt DateTime? @map("location_verified_at") @ignore
  verificationSource String?   @map("verification_source")

  @@map("arcade_public_details")
}

model ArcadeCabinet {
  id                 Int                  @id @default(autoincrement())
  arcadeId           Int                  @map("arcade_id")
  arcade             Arcade               @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  label              String?
  position           Int
  isActive           Boolean              @default(true) @map("is_active")
  availability       String               @default("unknown")
  condition          String               @default("unknown")
  // 위치 메모(「안쪽 벽」) — 이름 옆에 보인다
  note               String?
  // 상태 이유(「우측 건반 씹힘」) — 보통·주의일 때 상태 라벨 팝오버로 보인다
  conditionNote      String?              @map("condition_note")
  // 태그(방송기체 · 헤드폰 단자 …) — lib/arcadeDetails ARCADE_CABINET_TAGS 의 값
  tags               String[]             @default([])
  // 특징(정해진 보기 3단계 · 모르면 비움) — ARCADE_CABINET_FEATURES, 그 밖의 이야기는 featureNote(100자)
  keyWeight          String?              @map("key_weight")
  screenLag          String?              @map("screen_lag")
  soundVolume        String?              @map("sound_volume")
  featureNote        String?              @map("feature_note")
  verifiedAt         DateTime?            @map("verified_at")
  validUntil         DateTime?            @map("valid_until")
  verificationSource String?              @map("verification_source")
  reports            FeedbackReport[]
  checks             ArcadeCabinetCheck[]

  @@unique([arcadeId, position])
  @@index([arcadeId, isActive])
  @@map("arcade_cabinets")
}

// 이용자가 「지금 가동 중」 을 한 번 눌러 남기는 기체 확인 기록. 관리자 검증과 별개의 신선도 출처
model ArcadeCabinetCheck {
  id        Int           @id @default(autoincrement())
  cabinetId Int           @map("cabinet_id")
  cabinet   ArcadeCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  userId    Int           @map("user_id")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedAt DateTime      @default(now()) @map("checked_at")

  @@index([cabinetId, checkedAt])
  @@index([userId, checkedAt])
  @@map("arcade_cabinet_checks")
}

model ArcadePublicPhoto {
  id                Int       @id @default(autoincrement())
  arcadeId          Int       @map("arcade_id")
  arcade            Arcade    @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  slot              Int
  url               String
  alt               String
  capturedAt        DateTime? @map("captured_at")
  rightsConfirmedAt DateTime  @map("rights_confirmed_at")
  publicConsentAt   DateTime  @map("public_consent_at")

  @@unique([arcadeId, slot])
  @@map("arcade_public_photos")
}

model ArcadeLocalizedIdentity {
  id         Int        @id @default(autoincrement())
  arcadeId   Int        @map("arcade_id")
  arcade     Arcade     @relation(fields: [arcadeId], references: [id], onDelete: Cascade)
  locale     LocaleCode
  name       String
  aliases    String[]   @default([])
  reviewedAt DateTime   @map("reviewed_at")

  @@unique([arcadeId, locale])
  @@map("arcade_localized_identities")
  @@ignore
}

model ArcadeSlugAlias {
  slug     String @id
  arcadeId Int    @map("arcade_id")
  arcade   Arcade @relation(fields: [arcadeId], references: [id], onDelete: Cascade)

  @@index([arcadeId])
  @@map("arcade_slug_aliases")
  @@ignore
}

enum ArcadeReportType {
  address
  condition
  count
  hours
  other
  price
  unavailable

  @@map("arcade_report_type")
}
