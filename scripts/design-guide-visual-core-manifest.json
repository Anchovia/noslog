    "claimGates": [
        {
            "plate": "cover",
            "contract": "Editorial notation only; neutral colors exclusively"
        },
        {
            "plate": "typography",
            "contract": "Official Pretendard JP 1.3.9 files and exact 400/500/600/700 weights"
        },
        {
            "plate": "neutral-and-color",
            "contract": "Exact document 24 values; chroma appears only with its approved role label"
        },
        {
            "plate": "material",
            "contract": "Exact Spectrum token layer anatomy; no simulated blur presented as normative appearance"
        },
        {
            "plate": "iconography",
            "contract": "Lucide 1.24.0 published SVG geometry, viewBox, stroke, linecap, and linejoin"
        },
        {
            "plate": "guardrails",
            "contract": "No rejected candidate reuse and no domain color outside an explicitly named domain role"
        },
        {
            "plate": "motion-and-reduced-motion",
            "contract": "Exact MO-02 Atlassian durations and cubic-bezier curves; reduced mode removes nonessential spatial motion and applies state immediately"
        },
        {
            "plate": "data-visualization",
            "contract": "DV-05 Primer anatomy with NosLog colors, exact-value interaction, non-color distinction, and same-data semantic table"
        },
        {
            "plate": "responsive",
            "contract": "Exact document 24 track, gutter, margin, and content-fit contracts; diagrams are explicitly scaled"
        },
        {
            "plate": "reusable-ui",
            "contract": "Only FPR-04 responsibility aliases and patterns; no new component appearance or universal overlay"
        },
        {
            "plate": "representative-fragments",
            "contract": "Approved ordinary-UI pressures only, visibly schematic, not final pages, and no chart viewer/editor content"
        }
