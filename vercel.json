{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run vercel-build",
    "regions": ["icn1"],
    "git": {
        "deploymentEnabled": {
            "**": false,
            "main": true
        }
    },
    "crons": [
        {
            "path": "/api/cron/privacy-retention",
            "schedule": "0 18 * * *"
        }
    ]
}
