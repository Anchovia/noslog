{
    "name": "noslog",
    "version": "1.5.0",
    "private": true,
    "scripts": {
        "predev": "npm run generate:jacket-manifest",
        "dev": "next dev",
        "prebuild": "npm run generate:jacket-manifest",
        "build": "next build",
        "vercel-build": "npm run db:migrate:deploy && npm run build",
        "start": "next start",
        "postinstall": "prisma generate",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:import:exams:op3": "node prisma/import-op3-exams.mjs --env-file=.env",
        "db:import:bingos:op3": "node prisma/import-op3-bingos.mjs --env-file=.env",
        "db:import:musics:nosdata": "node prisma/import-nosdata-musics.mjs --env-file=.env",
        "db:import:tiers:official": "node prisma/import-official-tiers.mjs --env-file=.env",
        "simulate:rating:basic": "jiti scripts/simulate-basic-tier-rating.ts --env-file=.env",
        "generate:jacket-manifest": "node scripts/generate-music-jacket-manifest.mjs",
        "db:seed:e2e": "node prisma/seed-e2e.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,md,mjs}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@hookform/resolvers": "^5.4.0",
        "@prisma/client": "^6.19.3",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-slider": "^1.4.3",
        "@radix-ui/react-switch": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.17",
        "@vercel/blob": "^2.6.1",
        "axios": "^1.18.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "iron-session": "^8.0.4",
        "lucide-react": "^1.24.0",
        "next": "16.2.10",
        "pixi.js": "^8.19.0",
        "prisma": "^6.19.3",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.81.0",
        "recharts": "^3.9.2",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^24.13.3",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.2.10",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "postcss": "^8",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.3.2",
        "typescript": "~5.9.3",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3"
    }
}
