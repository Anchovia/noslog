{
    "name": "noslog",
    "version": "2.17.2",
    "private": true,
    "scripts": {
        "predev": "npm run generate:jacket-manifest",
        "dev": "next dev",
        "prebuild": "npm run generate:jacket-manifest",
        "build": "next build",
        "vercel-build": "npm run db:migrate:deploy && npm run build",
        "start": "next start",
        "postinstall": "prisma generate",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:import:exams:op3": "node prisma/import-op3-exams.mjs --env-file=.env",
        "db:import:bingos:op3": "node prisma/import-op3-bingos.mjs --env-file=.env",
        "db:import:musics": "node prisma/import-music-catalog.mjs --env-file=.env",
        "db:import:tiers:official": "node prisma/import-official-tiers.mjs --env-file=.env",
        "simulate:rating:basic": "jiti scripts/simulate-basic-tier-rating.ts --env-file=.env",
        "db:backfill:pattern-metrics": "jiti scripts/backfill-pattern-metrics.ts",
        "measure:queries": "node scripts/measure-queries.mjs",
        "generate:profile-card-icon": "node scripts/generate-profile-card-icon.mjs",
        "convert:jackets": "node scripts/convert-music-jackets.mjs && node scripts/generate-music-jacket-manifest.mjs",
        "generate:jacket-manifest": "node scripts/generate-music-jacket-manifest.mjs",
        "vendor:pretendard-jp": "node scripts/vendor-pretendard-jp.mjs",
        "db:seed:e2e": "node prisma/seed-e2e.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:a11y": "playwright test e2e/accessibility.spec.ts",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "check:dependencies": "knip --dependencies",
        "audit:production": "npm audit --omit=dev --audit-level=moderate",
        "audit:unused": "knip",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "eslint . --concurrency=4",
        "lint:schema": "prisma-lint prisma/schema",
        "lint:migrations": "node scripts/lint-migrations.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build",
        "test:storybook": "vitest run --config vitest.storybook.config.ts"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,css,md,mdx,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@google/genai": "^2.21.0",
        "@hookform/resolvers": "^5.4.0",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@radix-ui/react-dialog": "^1.1.19",
        "@radix-ui/react-popover": "^1.1.19",
        "@radix-ui/react-select": "^2.3.3",
        "@radix-ui/react-slider": "^1.4.3",
        "@radix-ui/react-tabs": "^1.1.17",
        "@t3-oss/env-nextjs": "^0.13.11",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-query-devtools": "^5.102.8",
        "@vercel/blob": "^2.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "iron-session": "^8.0.4",
        "lucide-react": "^1.24.0",
        "next": "16.4.3",
        "nuqs": "^2.10.1",
        "pixi.js": "^8.19.0",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "react-hook-form": "^7.81.0",
        "react-markdown": "10.1.0",
        "recharts": "^3.9.2",
        "remark-gfm": "^4.0.1",
        "server-only": "^0.0.1",
        "sharp": "0.35.5",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.61.1",
        "@storybook/addon-a11y": "10.6.5",
        "@storybook/addon-docs": "10.6.5",
        "@storybook/addon-vitest": "10.6.5",
        "@storybook/nextjs-vite": "10.6.5",
        "@tailwindcss/postcss": "^4.3.2",
        "@tanstack/eslint-plugin-query": "^5.102.8",
        "@types/hast": "3.0.5",
        "@types/node": "^24.13.3",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitest/browser-playwright": "4.1.12",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.4.3",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "eslint-plugin-storybook": "10.6.5",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "knip": "^6.34.0",
        "lint-staged": "^17.0.8",
        "postcss": "^8",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "prisma": "^7.10.1",
        "prisma-lint": "^0.13.1",
        "squawk-cli": "^2.66.0",
        "storybook": "10.6.5",
        "tailwindcss": "^4.3.2",
        "typescript": "~5.9.3",
        "vite": "8.3.3",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "lodash": "4.18.1",
        "@prisma/config": {
            "deepmerge-ts": "8.0.2"
        },
        "@vercel/cli-config": {
            "zod": "$zod"
        },
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3"
    },
    "engines": {
        "node": "24.x"
    },
    "packageManager": "npm@11.16.0"
}
