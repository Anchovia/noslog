{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "deny": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(git stash)",
            "Bash(git stash *)",
            "Bash(git reset --hard *)",
            "Bash(git checkout .)",
            "Bash(git checkout -- *)",
            "Bash(git restore *)",
            "Bash(git clean *)",
            "Bash(npx prisma migrate reset *)",
            "Bash(prisma migrate reset *)",
            "Bash(npx prisma db push *)",
            "Bash(prisma db push *)",
            "Bash(* --accept-data-loss *)",
            "Bash(* --force)",
            "Bash(* --force *)",
            "Bash(*PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION*)",
            "Bash(*.env.production.local*)",
            "Read(.env.production.local)"
        ]
    }
}
