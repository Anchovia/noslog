{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "deny": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git push *)",
            "Bash(npx prisma migrate reset *)",
            "Bash(prisma migrate reset *)",
            "Bash(npx prisma db push *)",
            "Bash(prisma db push *)",
            "Bash(* --accept-data-loss *)",
            "Read(.env.production.local)"
        ]
    }
}
